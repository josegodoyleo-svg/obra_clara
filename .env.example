# ============================================
# ObraClara AI — Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores

# --- API Keys ---
GEMINI_API_KEY=TU_API_KEY_AQUI

# --- Blockchain (HSK Chain Testnet — HashKey Chain) ---
# Documentación: https://chainlist.org/chain/133
# Explorer: https://testnet-explorer.hskchain.net

# Clave privada de la wallet desplegadora (sin prefijo 0x)
# Genera una con: node contract/scripts/generate-wallet.js
PRIVATE_KEY=TU_PRIVATE_KEY_AQUI

# RPC de HSK Chain Testnet (Chain ID: 133, Moneda: HSK)
RPC_URL=https://testnet.hsk.xyz

# Dirección del contrato ObraRegistry desplegado
CONTRACT_ADDRESS=

# Chain ID de HSK Testnet
CHAIN_ID=133

# --- Backend ---
PORT=3001

# --- Frontend (variables públicas con prefijo VITE_) ---
VITE_API_URL=http://localhost:3001/api
VITE_CONTRACT_ADDRESS=
VITE_RPC_URL=https://testnet.hsk.xyz
VITE_CHAIN_ID=133
